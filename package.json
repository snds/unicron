{
  "name": "unicron",
  "private": true,
  "version": "0.0.0",
  "description": "Sean Sands' shared design system: three-tier tokens, shadcn/Base UI primitives, and a playground.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "lint:tokens": "node packages/tokens/scripts/lint.mjs",
    "test": "pnpm -r test",
    "tokens:build": "pnpm --filter @unicron/tokens build",
    "dev": "pnpm --filter @unicron/ui... build && pnpm --filter playground dev",
    "ds:scan": "dsa scan",
    "ds:patterns": "dsa patterns",
    "ds:ratchet": "dsa ratchet",
    "pack:packages": "pnpm -r --filter \"@unicron/*\" pack --pack-destination artifacts",
    "changeset": "changeset",
    "regen": "node tools/shadcn-material/transform.mjs",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@snds/dsa": "git+https://github.com/snds/dsa.git#cc4cb051cf6097f7810eacc770ebaaba3feb97ea",
    "oxlint": "^1.88.0",
    "typescript": "~5.9.3"
  }
}
