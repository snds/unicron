{
  "$description": "App theme (an example app layer, a fixture of the playground and the contrast tool): Synapse. The 10 theme slots, 5 per ground: the accent, all an app sets since Unicron 2.0 (every other role is shared). Figma's `synapse / graphite` and `synapse / stone` modes of `Unicron / Theme`, read 2026-11-24 from the published library. This file and synapse.css beside it are the playground's copy of the theme Synapse declares, so the theme switcher can show it and `unicron-contrast` measures it (its exceptions: synapse.exceptions.json). Raw hex only; a change is a change in Figma first (scripts/figma-parity.mjs holds this file to the read-out).",
  "$extensions": {
    "unicron.app": {
      "name": "synapse",
      "order": 4,
      "figmaModes": {
        "graphite": "synapse / graphite",
        "stone": "synapse / stone"
      }
    }
  },
  "theme": {
    "graphite": {
      "primary-fill": {
        "$type": "color",
        "$value": "#B42A72",
        "$description": "Figma primary/fill in synapse / graphite."
      },
      "primary-on-fill": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Figma primary/on-fill in synapse / graphite."
      },
      "primary-text": {
        "$type": "color",
        "$value": "#F28FC4",
        "$description": "Figma primary/text in synapse / graphite."
      },
      "primary-soft": {
        "$type": "color",
        "$value": "#B42A722E",
        "$description": "Figma primary/soft in synapse / graphite."
      },
      "primary-display": {
        "$type": "color",
        "$value": "#F28FC4",
        "$description": "Figma primary/display in synapse / graphite."
      }
    },
    "stone": {
      "primary-fill": {
        "$type": "color",
        "$value": "#A8226A",
        "$description": "Figma primary/fill in synapse / stone."
      },
      "primary-on-fill": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Figma primary/on-fill in synapse / stone."
      },
      "primary-text": {
        "$type": "color",
        "$value": "#A3195F",
        "$description": "Figma primary/text in synapse / stone."
      },
      "primary-soft": {
        "$type": "color",
        "$value": "#A8226A1A",
        "$description": "Figma primary/soft in synapse / stone."
      },
      "primary-display": {
        "$type": "color",
        "$value": "#A3195F",
        "$description": "Figma primary/display in synapse / stone."
      }
    }
  }
}
