{
  "$description": "App theme (an example app layer, a fixture of the playground and the contrast tool): Warpcore. The 10 theme slots, 5 per ground: the accent, all an app sets since Unicron 2.0 (every other role is shared). Figma's `warpcore / graphite` and `warpcore / stone` modes of `Unicron / Theme`, read 2026-11-24 from the published library. This file and warpcore.css beside it are the playground's copy of the theme Warpcore declares, so the theme switcher can show it and `unicron-contrast` measures it (its exceptions: warpcore.exceptions.json). Raw hex only; a change is a change in Figma first (scripts/figma-parity.mjs holds this file to the read-out).",
  "$extensions": {
    "unicron.app": {
      "name": "warpcore",
      "order": 1,
      "figmaModes": {
        "graphite": "warpcore / graphite",
        "stone": "warpcore / stone"
      }
    }
  },
  "theme": {
    "graphite": {
      "primary-fill": {
        "$type": "color",
        "$value": "#5B54E8",
        "$description": "Figma primary/fill in warpcore / graphite."
      },
      "primary-on-fill": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Figma primary/on-fill in warpcore / graphite."
      },
      "primary-text": {
        "$type": "color",
        "$value": "#A3A8FF",
        "$description": "Figma primary/text in warpcore / graphite."
      },
      "primary-soft": {
        "$type": "color",
        "$value": "#5B54E82E",
        "$description": "Figma primary/soft in warpcore / graphite."
      },
      "primary-display": {
        "$type": "color",
        "$value": "#A3A8FF",
        "$description": "Figma primary/display in warpcore / graphite."
      }
    },
    "stone": {
      "primary-fill": {
        "$type": "color",
        "$value": "#4F46E5",
        "$description": "Figma primary/fill in warpcore / stone."
      },
      "primary-on-fill": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Figma primary/on-fill in warpcore / stone."
      },
      "primary-text": {
        "$type": "color",
        "$value": "#4B44D6",
        "$description": "Figma primary/text in warpcore / stone."
      },
      "primary-soft": {
        "$type": "color",
        "$value": "#4F46E51A",
        "$description": "Figma primary/soft in warpcore / stone."
      },
      "primary-display": {
        "$type": "color",
        "$value": "#4B44D6",
        "$description": "Figma primary/display in warpcore / stone."
      }
    }
  }
}
