{
  "$description": "App theme (an example app layer, a fixture of the playground and the contrast tool): Vale. The 10 theme slots, 5 per ground: the accent, all an app sets since Unicron 2.0 (every other role is shared). Figma's `vale / graphite` and `vale / stone` modes of `Unicron / Theme`, read 2026-11-24 from the published library. This file and vale.css beside it are the playground's copy of the theme Vale declares, so the theme switcher can show it and `unicron-contrast` measures it (its exceptions: vale.exceptions.json). Raw hex only; a change is a change in Figma first (scripts/figma-parity.mjs holds this file to the read-out).",
  "$extensions": {
    "unicron.app": {
      "name": "vale",
      "order": 2,
      "figmaModes": {
        "graphite": "vale / graphite",
        "stone": "vale / stone"
      }
    }
  },
  "theme": {
    "graphite": {
      "primary-fill": {
        "$type": "color",
        "$value": "#27728F",
        "$description": "Figma primary/fill in vale / graphite."
      },
      "primary-on-fill": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Figma primary/on-fill in vale / graphite."
      },
      "primary-text": {
        "$type": "color",
        "$value": "#86BDD7",
        "$description": "Figma primary/text in vale / graphite."
      },
      "primary-soft": {
        "$type": "color",
        "$value": "#27728F38",
        "$description": "Figma primary/soft in vale / graphite."
      },
      "primary-display": {
        "$type": "color",
        "$value": "#58A0BE",
        "$description": "Figma primary/display in vale / graphite."
      }
    },
    "stone": {
      "primary-fill": {
        "$type": "color",
        "$value": "#186683",
        "$description": "Figma primary/fill in vale / stone."
      },
      "primary-on-fill": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Figma primary/on-fill in vale / stone."
      },
      "primary-text": {
        "$type": "color",
        "$value": "#186683",
        "$description": "Figma primary/text in vale / stone."
      },
      "primary-soft": {
        "$type": "color",
        "$value": "#1866831A",
        "$description": "Figma primary/soft in vale / stone."
      },
      "primary-display": {
        "$type": "color",
        "$value": "#186683",
        "$description": "Figma primary/display in vale / stone."
      }
    }
  }
}
