{
  "$description": "App theme (an example app layer, a fixture of the playground and the contrast tool): Lockdown. The 10 theme slots, 5 per ground: the accent, all an app sets since Unicron 2.0 (every other role is shared). Figma's `lockdown / graphite` and `lockdown / stone` modes of `Unicron / Theme`, read 2026-11-24 from the published library. This file and lockdown.css beside it are the playground's copy of the theme Lockdown declares, so the theme switcher can show it and `unicron-contrast` measures it (its exceptions: lockdown.exceptions.json). Raw hex only; a change is a change in Figma first (scripts/figma-parity.mjs holds this file to the read-out).",
  "$extensions": {
    "unicron.app": {
      "name": "lockdown",
      "order": 3,
      "figmaModes": {
        "graphite": "lockdown / graphite",
        "stone": "lockdown / stone"
      }
    }
  },
  "theme": {
    "graphite": {
      "primary-fill": {
        "$type": "color",
        "$value": "#8A6A5E",
        "$description": "Figma primary/fill in lockdown / graphite."
      },
      "primary-on-fill": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Figma primary/on-fill in lockdown / graphite."
      },
      "primary-text": {
        "$type": "color",
        "$value": "#D4B3A5",
        "$description": "Figma primary/text in lockdown / graphite."
      },
      "primary-soft": {
        "$type": "color",
        "$value": "#A180722E",
        "$description": "Figma primary/soft in lockdown / graphite."
      },
      "primary-display": {
        "$type": "color",
        "$value": "#D4B3A5",
        "$description": "Figma primary/display in lockdown / graphite."
      }
    },
    "stone": {
      "primary-fill": {
        "$type": "color",
        "$value": "#7D5E54",
        "$description": "Figma primary/fill in lockdown / stone."
      },
      "primary-on-fill": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Figma primary/on-fill in lockdown / stone."
      },
      "primary-text": {
        "$type": "color",
        "$value": "#7D5E54",
        "$description": "Figma primary/text in lockdown / stone."
      },
      "primary-soft": {
        "$type": "color",
        "$value": "#7D5E541A",
        "$description": "Figma primary/soft in lockdown / stone."
      },
      "primary-display": {
        "$type": "color",
        "$value": "#7D5E54",
        "$description": "Figma primary/display in lockdown / stone."
      }
    }
  }
}
