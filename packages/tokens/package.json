{
  "name": "@unicron/tokens",
  "version": "0.2.0",
  "description": "unicron design tokens: DTCG JSON source, three tiers (global → semantic → component), built to CSS custom properties and a Tailwind v4 theme map.",
  "license": "Apache-2.0",
  "author": "Sean Sands",
  "homepage": "https://github.com/snds/unicron/tree/main/packages/tokens#readme",
  "bugs": "https://github.com/snds/unicron/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snds/unicron.git",
    "directory": "packages/tokens"
  },
  "keywords": ["design-tokens", "dtcg", "tailwindcss", "shadcn", "design-system"],
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "tokens", "examples", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/tokens.json",
    "./tokens.css": "./dist/tokens.css",
    "./dist/tokens.css": "./dist/tokens.css",
    "./dist/tokens.json": "./dist/tokens.json",
    "./examples/*": "./examples/*",
    "./tokens/*": "./tokens/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node scripts/build.mjs && node scripts/check.mjs && node scripts/contrast.mjs",
    "contrast": "node scripts/contrast.mjs",
    "typecheck": "node --check scripts/build.mjs && node --check scripts/check.mjs && node --check scripts/lint.mjs && node --check scripts/contrast.mjs"
  },
  "devDependencies": {
    "apca-w3": "^0.1.9"
  }
}
