{
  "name": "@unicron/tokens",
  "version": "2.3.0",
  "description": "unicron design tokens: DTCG JSON source, three tiers (global → semantic → component), one generic default theme on two grounds, built to CSS custom properties and a Tailwind v4 theme map; and the contrast tool an app runs on its own theme.",
  "license": "Apache-2.0",
  "author": "Sean Sands",
  "homepage": "https://github.com/snds/unicron/tree/main/packages/tokens#readme",
  "bugs": "https://github.com/snds/unicron/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snds/unicron.git",
    "directory": "packages/tokens"
  },
  "keywords": ["design-tokens", "dtcg", "tailwindcss", "shadcn", "design-system"],
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "tokens", "src", "examples", "scripts/contrast.mjs", "scripts/lib", "scripts/recipes", "README.md", "LICENSE", "NOTICE"],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "unicron-contrast": "./scripts/contrast.mjs"
  },
  "exports": {
    ".": "./dist/tokens.json",
    "./tokens.css": "./dist/tokens.css",
    "./dist/tokens.css": "./dist/tokens.css",
    "./plain.css": "./dist/plain.css",
    "./dist/plain.css": "./dist/plain.css",
    "./dist/tokens.json": "./dist/tokens.json",
    "./examples/*": "./examples/*",
    "./tokens/*": "./tokens/*",
    "./spring": {
      "types": "./src/spring.d.mts",
      "default": "./src/spring.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node scripts/build.mjs && node scripts/check.mjs && node scripts/figma-parity.mjs && node scripts/contrast.mjs && node scripts/contrast.mjs examples/app-extension.css && node scripts/contrast.mjs ../../apps/playground/src/app-themes",
    "contrast": "node scripts/contrast.mjs",
    "parity": "node scripts/figma-parity.mjs",
    "typecheck": "node scripts/syntax.mjs",
    "contrast:fixtures": "node scripts/contrast.mjs ../../apps/playground/src/app-themes"
  },
  "dependencies": {
    "apca-w3": "^0.1.9"
  }
}
