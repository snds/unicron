{
  "$description": "Tier 1 · Global primitives. Raw values only. Emitted as --g-*. Never referenced by components directly; semantic tokens alias these.",
  "neutral": {
    "$description": "Neutral ramp, slightly cool (hue 260) so long reading sessions feel calm.",
    "0": { "$type": "color", "$value": "oklch(1 0 0)" },
    "25": { "$type": "color", "$value": "oklch(0.987 0.002 260)" },
    "50": { "$type": "color", "$value": "oklch(0.974 0.003 260)" },
    "100": { "$type": "color", "$value": "oklch(0.948 0.004 260)" },
    "200": { "$type": "color", "$value": "oklch(0.91 0.006 260)" },
    "300": { "$type": "color", "$value": "oklch(0.85 0.008 260)" },
    "400": { "$type": "color", "$value": "oklch(0.71 0.01 260)" },
    "500": { "$type": "color", "$value": "oklch(0.556 0.012 260)" },
    "600": { "$type": "color", "$value": "oklch(0.44 0.012 260)" },
    "700": { "$type": "color", "$value": "oklch(0.34 0.012 260)" },
    "800": { "$type": "color", "$value": "oklch(0.26 0.01 260)" },
    "850": { "$type": "color", "$value": "oklch(0.22 0.009 260)" },
    "900": { "$type": "color", "$value": "oklch(0.185 0.008 260)" },
    "950": { "$type": "color", "$value": "oklch(0.145 0.006 260)" }
  },
  "blue": {
    "$description": "Accent hues. 500 is the light-mode step, 400 the dark-mode step (lighter, so it keeps contrast on dark surfaces).",
    "500": { "$type": "color", "$value": "oklch(0.6 0.19 255)" },
    "400": { "$type": "color", "$value": "oklch(0.7 0.15 255)" }
  },
  "coral": {
    "500": { "$type": "color", "$value": "oklch(0.63 0.2 25)" },
    "400": { "$type": "color", "$value": "oklch(0.72 0.16 25)" }
  },
  "green": {
    "500": { "$type": "color", "$value": "oklch(0.62 0.15 160)" },
    "400": { "$type": "color", "$value": "oklch(0.72 0.13 160)" }
  },
  "amber": {
    "500": { "$type": "color", "$value": "oklch(0.75 0.16 75)" },
    "400": { "$type": "color", "$value": "oklch(0.82 0.14 80)" }
  },
  "red": {
    "500": { "$type": "color", "$value": "oklch(0.577 0.245 27.3)" },
    "400": { "$type": "color", "$value": "oklch(0.704 0.191 22.2)" }
  },
  "hue": {
    "$description": "Bare hue angles for tinted surfaces. Lightness and chroma are semantic, so one hue gives a pastel wash in light mode and a deep one in dark.",
    "red": { "$type": "number", "$value": 25 },
    "orange": { "$type": "number", "$value": 55 },
    "yellow": { "$type": "number", "$value": 95 },
    "green": { "$type": "number", "$value": 150 },
    "teal": { "$type": "number", "$value": 190 },
    "blue": { "$type": "number", "$value": 245 },
    "purple": { "$type": "number", "$value": 300 },
    "pink": { "$type": "number", "$value": 350 },
    "brown": { "$type": "number", "$value": 65 },
    "gray": { "$type": "number", "$value": 260 }
  },
  "radius": {
    "base": { "$type": "dimension", "$value": "0.625rem" }
  },
  "duration": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "base": { "$type": "duration", "$value": "200ms" }
  },
  "ease": {
    "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  },
  "font": {
    "sans": { "$type": "fontFamily", "$value": ["Inter Variable", "ui-sans-serif", "system-ui", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"] }
  }
}
