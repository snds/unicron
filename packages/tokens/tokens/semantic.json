{
  "$description": "Tier 2 · Semantic roles. Emitted as --* (no prefix): the shadcn/ui contract plus the sidebar contract. `$value` is light mode; `$extensions[\"unicron.modes\"].dark` is dark mode. Apps add their own roles in an extension layer (see examples/app-extension.css), never here.",
  "$extensions": {
    "unicron.theme": {
      "$description": "Extra entries for the Tailwind v4 `@theme inline` block. Radius steps are multiples of --radius.",
      "radius": { "sm": 0.6, "md": 0.8, "lg": 1, "xl": 1.4, "2xl": 1.8, "3xl": 2.2, "4xl": 2.6 }
    }
  },
  "background": { "$type": "color", "$value": "{neutral.0}", "$extensions": { "unicron.modes": { "dark": "{neutral.950}" } } },
  "foreground": { "$type": "color", "$value": "{neutral.950}", "$extensions": { "unicron.modes": { "dark": "{neutral.25}" } } },
  "card": { "$type": "color", "$value": "{neutral.0}", "$extensions": { "unicron.modes": { "dark": "{neutral.900}" } } },
  "card-foreground": { "$type": "color", "$value": "{neutral.950}", "$extensions": { "unicron.modes": { "dark": "{neutral.25}" } } },
  "popover": { "$type": "color", "$value": "{neutral.0}", "$extensions": { "unicron.modes": { "dark": "{neutral.900}" } } },
  "popover-foreground": { "$type": "color", "$value": "{neutral.950}", "$extensions": { "unicron.modes": { "dark": "{neutral.25}" } } },
  "primary": { "$type": "color", "$value": "{neutral.900}", "$extensions": { "unicron.modes": { "dark": "{neutral.100}" } } },
  "primary-foreground": { "$type": "color", "$value": "{neutral.25}", "$extensions": { "unicron.modes": { "dark": "{neutral.900}" } } },
  "secondary": { "$type": "color", "$value": "{neutral.100}", "$extensions": { "unicron.modes": { "dark": "{neutral.800}" } } },
  "secondary-foreground": { "$type": "color", "$value": "{neutral.900}", "$extensions": { "unicron.modes": { "dark": "{neutral.25}" } } },
  "muted": { "$type": "color", "$value": "{neutral.100}", "$extensions": { "unicron.modes": { "dark": "{neutral.800}" } } },
  "muted-foreground": { "$type": "color", "$value": "{neutral.600}", "$extensions": { "unicron.modes": { "dark": "{neutral.300}" } }, "$description": "Secondary text, drawn small. Steps chosen for APCA Lc ≥ 60 on background, card, popover, sidebar, accent and muted in each mode (scripts/contrast.mjs)." },
  "accent": { "$type": "color", "$value": "{neutral.100}", "$extensions": { "unicron.modes": { "dark": "{neutral.800}" } } },
  "accent-foreground": { "$type": "color", "$value": "{neutral.900}", "$extensions": { "unicron.modes": { "dark": "{neutral.25}" } } },
  "destructive": { "$type": "color", "$value": "{red.500}", "$extensions": { "unicron.modes": { "dark": "{red.400}" } } },
  "warning": { "$type": "color", "$value": "{amber.500}", "$extensions": { "unicron.modes": { "dark": "{amber.400}" } } },
  "warning-foreground": { "$type": "color", "$value": "{neutral.950}", "$extensions": { "unicron.modes": { "dark": "{neutral.950}" } } },
  "info": { "$type": "color", "$value": "{blue.500}", "$extensions": { "unicron.modes": { "dark": "{blue.400}" } } },
  "info-foreground": { "$type": "color", "$value": "{neutral.0}", "$extensions": { "unicron.modes": { "dark": "{neutral.950}" } } },
  "protected": { "$type": "color", "$value": "{neutral.950}", "$extensions": { "unicron.modes": { "dark": "{neutral.25}" } } },
  "protected-foreground": { "$type": "color", "$value": "{neutral.25}", "$extensions": { "unicron.modes": { "dark": "{neutral.950}" } } },
  "border": { "$type": "color", "$value": "{neutral.200}", "$extensions": { "unicron.modes": { "dark": "{white-alpha.10}" } } },
  "input": { "$type": "color", "$value": "{neutral.200}", "$extensions": { "unicron.modes": { "dark": "{white-alpha.15}" } } },
  "ring": { "$type": "color", "$value": "{neutral.900}", "$extensions": { "unicron.modes": { "dark": "{neutral.100}" } }, "$description": "Focus ring. The primitives draw it at 50% (ring-ring/50, outline-ring/50), so the step is dark enough that the half-strength ring still clears APCA Lc 30 on every surface (scripts/contrast.mjs)." },
  "radius": { "$type": "dimension", "$value": "{radius.base}" },

  "sidebar": { "$type": "color", "$value": "{neutral.50}", "$extensions": { "unicron.modes": { "dark": "{neutral.900}" } } },
  "sidebar-foreground": { "$type": "color", "$value": "{foreground}" },
  "sidebar-primary": { "$type": "color", "$value": "{primary}" },
  "sidebar-primary-foreground": { "$type": "color", "$value": "{primary-foreground}" },
  "sidebar-accent": { "$type": "color", "$value": "{accent}" },
  "sidebar-accent-foreground": { "$type": "color", "$value": "{accent-foreground}" },
  "sidebar-border": { "$type": "color", "$value": "{border}" },
  "sidebar-ring": { "$type": "color", "$value": "{ring}" },

  "font-sans": { "$type": "fontFamily", "$value": "{font.sans}" },
  "font-mono": { "$type": "fontFamily", "$value": "{font.mono}" },
  "font-heading": { "$type": "fontFamily", "$value": "{font-sans}" }
}
