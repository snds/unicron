{
  "name": "@unicron/ui",
  "version": "0.0.0",
  "description": "unicron React primitives: shadcn/ui (base-nova style) on Base UI, Material Symbols icons, styled with Tailwind v4 against @unicron/tokens.",
  "license": "Apache-2.0",
  "author": "Sean Sands",
  "homepage": "https://github.com/snds/unicron/tree/main/packages/ui#readme",
  "bugs": "https://github.com/snds/unicron/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snds/unicron.git",
    "directory": "packages/ui"
  },
  "keywords": ["react", "shadcn", "base-ui", "tailwindcss", "material-symbols", "design-system"],
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles": "./dist/styles/index.css",
    "./styles/*": "./dist/styles/*",
    "./icon": {
      "types": "./dist/components/icon.d.ts",
      "import": "./dist/components/icon.js",
      "default": "./dist/components/icon.js"
    },
    "./*": {
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/components/ui/*.js",
      "default": "./dist/components/ui/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-styles.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@unicron/tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "material-symbols": "^0.48.0",
    "next-themes": "^0.4.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~5.9.3"
  }
}
